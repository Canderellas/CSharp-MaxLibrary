<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MaxBots.Meta</AssemblyName>
    <RootNamespace>MaxBots</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>MaxBots.Meta</PackageId>
    <Description>Общие модели и DTO для Max Bot API.</Description>
    <PackageTags>max;maxbot;api;models</PackageTags>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\MaxBot\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>
</Project>
